PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox/live
# DATABASE_URL and AGENT_DATABASE_URL accept plain postgres:// / postgresql://
# URLs — they are normalized automatically (see dburl.py): SQLAlchemy gets the
# postgresql+psycopg:// dialect, raw psycopg never does, and *.supabase.co /
# *.supabase.com hosts get sslmode=require appended. So hosted strings (Render,
# Supabase pooler) can be pasted verbatim.
DATABASE_URL=postgresql+psycopg://tollgate:tollgate@localhost:5433/tollgate
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_PER_AGENT_PER_MIN=60
RATE_LIMIT_GLOBAL_PER_MIN=600
# Bootstrap credential for /v1/admin routes (X-Admin-Key header).
# Empty or unset = admin routes return 503. Generate: tga_$(openssl rand -hex 24)
ADMIN_API_KEY=

# --- dispute agent (agent/) ---
GEMINI_API_KEY=
# The agent's own gateway key (tg_...), issued via POST /v1/admin/agents
AGENT_API_KEY=
# Optional overrides (defaults shown):
# AGENT_MODEL=gemini-3.8-flash
# AGENT_MCP_URL=http://localhost:8000/mcp
# AGENT_DATABASE_URL=postgresql://tollgate:tollgate@localhost:5433/agent
# AGENT_TOKEN_BUDGET=100000
# AGENT_PROMPT_VERSION=v1
# Confidence floor (0..1) below which the decision schema forces
# escalate_human. Policy default, not a measured value.
# AGENT_MIN_CONFIDENCE=0.6

# --- webhooks (gateway/webhooks.py) ---
# Production: the webhook id from the PayPal developer dashboard; used
# with PayPal's verify-webhook-signature API.
# PAYPAL_WEBHOOK_ID=
# Dev/simulation: HMAC-SHA256 shared secret for scripts/simulate_dispute.py
# (X-Tollgate-Signature header). Must match on both processes.
# WEBHOOK_SHARED_SECRET=

# --- outbox worker (python -m worker) ---
# The worker reuses the AGENT_* values above and needs no PayPal
# credentials. The job queue lives in the gateway database
# (WORKER_DATABASE_URL, defaults to DATABASE_URL). Optional tunables
# (defaults shown):
# WORKER_MAX_ATTEMPTS=5
# WORKER_BACKOFF_BASE_SECONDS=2.0
# WORKER_BACKOFF_MAX_SECONDS=300.0
# WORKER_LEASE_SECONDS=300.0
# WORKER_POLL_INTERVAL_SECONDS=1.0
# WORKER_BATCH_SIZE=5

# --- deployment (Render free tier) ---
# Run the outbox worker as a daemon thread INSIDE the gateway process.
# Only for hosts that cannot run background workers (Render free plan).
# Off by default; the recommended shape is a separate `python -m worker`.
# WORKER_IN_PROCESS=1
